<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Required on Android 11+ to list every installed app in the per-app picker. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!--
        Android 11+ package visibility: without these declarations PackageManager only returns a
        filtered subset of installed apps, which is why the picker looked incomplete.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
    </queries>

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:description="@string/xposed_description"
        android:name=".LingXiKeyApplication"
        android:supportsRtl="true"
        android:theme="@style/Theme.LingXiKeyCustom">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".RootCommandTrampolineActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:permission="android.permission.MANAGE_USERS"
            android:theme="@style/Theme.RootCommandTrampoline" />
        <service
            android:name=".RootCommandService"
            android:exported="false"
            android:permission="android.permission.MANAGE_USERS"
            android:foregroundServiceType="dataSync" />
        <receiver
            android:name=".RootCommandReceiver"
            android:exported="true"
            android:permission="android.permission.MANAGE_USERS" />
    </application>
</manifest>
